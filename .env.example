# Shared GA4 measurement ID for all Marketplace apps (G-XXXXXXXXXX).
# Leave empty to disable analytics (e.g. local dev). Inlined at build time.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# REQUIRED. Server-side key used to encrypt the Edge admin Client Secret
# (AES-256-GCM; a 32-byte key is derived with HKDF-SHA256). Any passphrase of
# at least 16 characters, e.g. `openssl rand -base64 32`.
#
# Without it the app refuses to save credentials — it never stores a secret in
# plaintext. Keep it stable: changing it makes every stored secret
# undecryptable and users must re-enter their credentials. Server-only, never
# exposed to the browser (do NOT prefix with NEXT_PUBLIC_).
EDGE_SECRET_ENCRYPTION_KEY=

# Custom authorization (Sitecore Cloud Auth0) — see src/lib/marketplace-auth/README.md
# Client ID of the app's SPA client credentials from the Cloud Portal (required)
NEXT_PUBLIC_AUTH0_CLIENT_ID=
# Marketplace app ID (sent as product_codes=mkp_<id> at login)
NEXT_PUBLIC_SITECORE_APP_ID=
# Defaults shown; override only if Sitecore changes them
# NEXT_PUBLIC_AUTH0_DOMAIN=auth.sitecorecloud.io
# NEXT_PUBLIC_AUTH0_AUDIENCE=https://api-webapp.sitecorecloud.io
# NEXT_PUBLIC_AUTH0_SCOPE=openid profile email offline_access
# AUTH0_ISSUER=https://auth.sitecorecloud.io/
